    run("overlapping", [] {
        std::vector<Interval> want{{1, 6}, {8, 10}, {15, 18}};
        auto got = merge({{1, 3}, {2, 6}, {8, 10}, {15, 18}});
        expect(got == want, "merge: expected [[1,6],[8,10],[15,18]], got " + ivals(got));
    });
    run("touching_endpoints", [] {
        std::vector<Interval> want{{1, 5}};
        auto got = merge({{1, 4}, {4, 5}});
        expect(got == want, "merge: expected [[1,5]], got " + ivals(got));
    });
    run("unsorted_input", [] {
        std::vector<Interval> want{{0, 4}};
        auto got = merge({{1, 4}, {0, 4}});
        expect(got == want, "merge: expected [[0,4]], got " + ivals(got));
    });
    run("nested_interval", [] {
        std::vector<Interval> want{{1, 4}};
        auto got = merge({{1, 4}, {2, 3}});
        expect(got == want, "merge: expected [[1,4]], got " + ivals(got));
    });
    run("single_interval", [] {
        std::vector<Interval> want{{5, 7}};
        auto got = merge({{5, 7}});
        expect(got == want, "merge: expected [[5,7]], got " + ivals(got));
    });
    run("empty_input", [] {
        expect(merge({}).empty(), "merge of [] should be []");
    });
    run("chain_overlap", [] {
        std::vector<Interval> want{{0, 3}};
        auto got = merge({{2, 3}, {1, 2}, {0, 1}});
        expect(got == want, "merge: expected [[0,3]], got " + ivals(got));
    });
    run("rejects_inverted_interval", [] {
        expect_throws("inverted interval", [] { (void)merge({{3, 1}}); });
    });
