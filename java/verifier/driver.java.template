import java.util.Arrays;
import java.util.Objects;

public class LMHVerifier {
    static int total = 0;
    static int passed = 0;

    interface Block { void run() throws Exception; }

    static void run(String name, Block b) {
        long t0 = System.nanoTime();
        String status = "pass";
        String detail = "";
        try {
            b.run();
        } catch (Throwable t) {
            status = "fail";
            String m = t.getMessage();
            detail = t.getClass().getSimpleName() + (m == null || m.isEmpty() ? "" : ": " + m);
        }
        double ms = (System.nanoTime() - t0) / 1_000_000.0;
        total++;
        if ("pass".equals(status)) passed++;
        System.out.println("{\"case\":\"" + esc(name) + "\",\"status\":\"" + status
                + "\",\"ms\":" + ms + ",\"detail\":\"" + esc(detail) + "\"}");
    }

    static String esc(String s) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\' -> sb.append("\\\\");
                case '"' -> sb.append("\\\"");
                case '\n' -> sb.append("\\n");
                case '\r' -> sb.append("\\r");
                case '\t' -> sb.append("\\t");
                default -> {
                    if (c < 0x20) sb.append(String.format("\\u%04x", (int) c));
                    else sb.append(c);
                }
            }
        }
        return sb.toString();
    }

    static void eq(String what, Object expected, Object actual) {
        if (!Objects.equals(expected, actual)) {
            throw new AssertionError(what + ": expected " + expected + ", got " + actual);
        }
    }

    static void eqDeep(String what, int[][] expected, int[][] actual) {
        if (!Arrays.deepEquals(expected, actual)) {
            throw new AssertionError(what + ": expected " + Arrays.deepToString(expected)
                    + ", got " + Arrays.deepToString(actual));
        }
    }

    static void expectThrows(String what, Block b) {
        try {
            b.run();
        } catch (Throwable expected) {
            return;
        }
        throw new AssertionError(what + ": expected an exception, none thrown");
    }

    public static void main(String[] args) {
// CASES
        System.out.println("{\"summary\":{\"total\":" + total + ",\"passed\":" + passed
                + ",\"failed\":" + (total - passed) + "}}");
        if (passed < total) System.exit(1);
    }
}
